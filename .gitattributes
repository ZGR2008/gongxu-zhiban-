# Vendor hashes refer to these exact LF-normalized bytes on every platform.
apps/web/public/previews/vendor/** text eol=lf

# Generated document/media bytes must not undergo cross-platform newline conversion.
*.pdf binary
*.pptx binary
*.mp4 binary

# Unified diff context lines require their prefix space; keep this patch portable.
scripts/production-proxy.patch text eol=lf whitespace=-blank-at-eol
