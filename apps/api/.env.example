HOST=127.0.0.1
PORT=3001
CORS_ORIGIN=http://localhost:5173
# Local Compose example only. Configure a separate strong password in production.
DATABASE_URL=postgresql://review_user:REVIEW_LOCAL_PASSWORD@127.0.0.1:5432/gongxu_review

# DeepSeek chat example: set AI_BASE_URL=https://api.deepseek.com and
# AI_MODEL=deepseek-flash, then add your own AI_API_KEY locally.
# Leave all three empty until configured.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=90000

# Embeddings are independent of DeepSeek chat; configure a separate compatible service.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
AI_MAX_OUTPUT_TOKENS=4096
AI_REASONING_EFFORT=
