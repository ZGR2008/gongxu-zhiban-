{
  "name": "gongxu-zhiban",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @gongxu/api --filter @gongxu/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm check:env && pnpm -r --if-present test",
    "check:env": "node scripts/check-env-templates.mjs",
    "smoke": "node scripts/live-smoke.mjs",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "smoke:ui": "node scripts/ui-smoke.mjs",
    "smoke:visual": "node scripts/visual-smoke.mjs",
    "test:ui-models": "node --test scripts/ui-models.test.mjs",
    "test:workbench": "node --test scripts/workbench-models.test.mjs",
    "test:evidence": "node --test scripts/evidence-state.test.mjs",
    "verify:agent-recovery": "pnpm --filter @gongxu/api build && cd apps/api && node ../../scripts/agent-recovery-local.mjs",
    "smoke:workbench": "node scripts/workbench-smoke.mjs",
    "smoke:project-controls": "node scripts/project-controls-smoke.mjs",
    "start:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "test:review-package": "node --test scripts/review-package.test.mjs",
    "verify:reliability-ui": "node scripts/reliability-browser.mjs",
    "verify:web-entry": "node scripts/measure-web-entry.mjs --assert-deferred",
    "verify:local": "pnpm --filter @gongxu/api build && cd apps/api && node ../../scripts/reliability-local.mjs",
    "eval:offline": "pnpm --filter @gongxu/api build && node scripts/evaluate-offline.mjs",
    "eval:prepare": "pnpm --filter @gongxu/api build && node scripts/evaluate-prepare.mjs",
    "eval:report": "node scripts/evaluate-report.mjs",
    "test:eval-report": "node --test scripts/evaluation-report.test.mjs",
    "test:retrieval-evaluation": "node --test scripts/retrieval-evaluation.test.mjs",
    "eval:retrieval-local": "pnpm --filter @gongxu/api build && node scripts/evaluate-retrieval-local.mjs",
    "verify:review-context": "pnpm --filter @gongxu/api build && cd apps/api && node ../../scripts/review-context-local.mjs",
    "verify:growth-scope": "pnpm --filter @gongxu/api build && cd apps/api && node ../../scripts/growth-scope-local.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
